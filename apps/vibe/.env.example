# Public origin for this vibe host (metadata + Auth.js).
# Local: http://localhost:3005
SITE_URL=http://localhost:3005
AUTH_URL=http://localhost:3005
AUTH_TRUST_HOST=true

# Absolute cross-origin links (never relative paths on those hosts).
COMMUNITY_SITE_URL=https://strictlyjayers.com
FANTASY_HUB_URL=https://fantasy.strictlyjayers.com
FITNESS_URL=https://fitness.strictlyjayers.com

# Same Secret Manager values as sj-hub. Never commit real secrets.
# AUTH_SECRET=          # sj-auth-secret
# AUTH_GOOGLE_ID=       # sj-auth-google-id
# AUTH_GOOGLE_SECRET=   # sj-auth-google-secret
# ALLOWED_EMAILS=       # sj-allowed-emails (comma-separated)

# Local / Playwright: skip Google only when set to 1 (keep 0 in committed examples).
AUTH_DEV_BYPASS=0
SJ_DEV_VIEWER_EMAIL=demo@example.com

# Optional: hub_members.json root (same file as Fantasy). Unset → env allowlist only.
# SJ_HUB_DIR=../../data/sj
# Per-user vibe JSON. Unset → ../../data/vibe
# SJ_VIBE_DIR=../../data/vibe

# AES-256 key (64 hex chars) for GitHub PAT / OAuth token at rest.
SJ_VIBE_TOKEN_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# GitHub OAuth app (read:user + repo). Leave blank to use a pasted PAT only.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional Cloud Scheduler bearer for POST /api/cron/sync
# CRON_SECRET=
