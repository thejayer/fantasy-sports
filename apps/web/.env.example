# Auth.js / NextAuth
# Prefer Secret Manager + scripts/pull-hub-secrets.sh over hand-editing.
# Secret names (GCP project fantasy-sports-analytics):
#   sj-auth-secret, sj-auth-google-id, sj-auth-google-secret, sj-allowed-emails
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google accounts allowed into the hub
ALLOWED_EMAILS=you@example.com,friend@example.com

# Optional bootstrap admins (also used when hub_members.json has no admin yet).
# Ongoing membership + email↔team links live in {SJ_DATA_DIR}/hub_members.json
# via the /admin UI — sign-in allowlist is ALLOWED_EMAILS ∪ that file.
# ADMIN_EMAILS=you@example.com

# Local/dev only: skip Google auth entirely (keep 0 when using real secrets)
AUTH_DEV_BYPASS=0
# When bypass is on, treat this email as the signed-in member (franchise links
# in hub_members.json personalize / and the portfolio table). Playwright uses
# demo@example.com.
# SJ_DEV_VIEWER_EMAIL=demo@example.com

# Optional override for ESPN / synced snapshots (defaults to ../../data/sj then fixtures)
# SJ_DATA_DIR=/absolute/path/to/data/sj
#
# Hub-native writable store (golf leagues, hub_members, auction rooms).
# Defaults to ../hub beside SJ_DATA_DIR, or ../../data/hub. Keep this separate
# from SJ_DATA_DIR so sj sync/backfill never share index.json with golf.
# SJ_HUB_DIR=/absolute/path/to/data/hub

# Public /api/health marks a league stale after this many seconds (default 7200)
# SJ_HEALTH_STALE_SECONDS=7200

# ESPN cookies live in Secret Manager (sj-espn-s2 / sj-espn-swid) and are
# pulled into repo-root .env.espn by scripts/pull-hub-secrets.sh — not here.
