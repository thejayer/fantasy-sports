# Auth.js / NextAuth
# Prefer Secret Manager + scripts/pull-hub-secrets.sh over hand-editing.
# Secret names (GCP project fantasy-sports-analytics):
#   sj-auth-secret, sj-auth-google-id, sj-auth-google-secret, sj-allowed-emails
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google accounts allowed into the hub
ALLOWED_EMAILS=you@example.com,friend@example.com

# Local/dev only: skip Google auth entirely (keep 0 when using real secrets)
AUTH_DEV_BYPASS=0

# Optional override for synced snapshots (defaults to ../../data/sj then ../../fixtures/sj)
# SJ_DATA_DIR=/absolute/path/to/data/sj

# ESPN cookies live in Secret Manager (sj-espn-s2 / sj-espn-swid) and are
# pulled into repo-root .env.espn by scripts/pull-hub-secrets.sh — not here.
