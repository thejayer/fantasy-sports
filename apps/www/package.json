{
  "name": "strictly-jayers-www",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test e2e/smoke.spec.ts",
    "test:e2e:bets": "playwright test e2e/bets-smoke.spec.ts",
    "test:e2e:auth": "AUTH_DEV_BYPASS=0 PORT=3005 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3005 playwright test e2e/bets-auth.spec.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "braces": "3.0.3",
    "js-yaml": "^4.3.2",
    "minimatch": "^10.2.6",
    "postcss": "^8.5.23",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
