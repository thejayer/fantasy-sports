# Public origin for this portal (metadata + Auth.js callback host).
# Local: http://localhost:3002
SITE_URL=http://localhost:3002
AUTH_URL=http://localhost:3002
AUTH_TRUST_HOST=true

# Fantasy member hub — always an absolute cross-origin URL (never a relative path).
FANTASY_HUB_URL=https://fantasy.strictlyjayers.com

# Fitness training log — always an absolute cross-origin URL.
FITNESS_URL=https://fitness.strictlyjayers.com

# Optional community destinations.
# Discord defaults to the crew invite in lib/site.ts; set to override.
# DISCORD_INVITE_URL=https://discord.gg/6BH4CfB
# Public Palworld status line only — never put IPs or passwords here.
# PALWORLD_STATUS=World is up — ask Discord for the password.
PALWORLD_INFO_URL=

# Optional override for /watch. Default is the crew playlist in lib/watch.ts.
# YOUTUBE_PLAYLIST_ID=PLKHcH63ZKis3qFZg1O0ZiMrjGyYLa5kB1

# Same Secret Manager values as sj-hub. Never commit real secrets.
# AUTH_SECRET=          # sj-auth-secret
# AUTH_GOOGLE_ID=       # sj-auth-google-id
# AUTH_GOOGLE_SECRET=   # sj-auth-google-secret
# ALLOWED_EMAILS=       # sj-allowed-emails (comma-separated)

# Local / Playwright: skip Google and open /bets as SJ_DEV_VIEWER_EMAIL.
AUTH_DEV_BYPASS=1
SJ_DEV_VIEWER_EMAIL=demo@example.com

# Optional: hub_members.json + bets/ root (same bucket as Fantasy).
# SJ_HUB_DIR=../../data/sj
# SJ_BETS_DIR=./fixtures/bets
